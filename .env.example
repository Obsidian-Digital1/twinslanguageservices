# Resend API key used by app/api/contact/route.ts.
RESEND_API_KEY=

# Google Cloud reCAPTCHA Enterprise (Website • score / score-based v3-style).
# The Key ID from Google Cloud is the public site key.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
GOOGLE_CLOUD_PROJECT_ID=
RECAPTCHA_MIN_SCORE=0.5

# Optional comma-separated extra approved hostnames (e.g. staging/preview).
# Production always allows twins-languageservices.com and www.twins-languageservices.com.
# RECAPTCHA_ALLOWED_HOSTNAMES=

# Server authentication (choose one; never expose these to the browser):
# A/B) ADC / workload identity when hosted on Google Cloud — no extra vars needed.
# C) Restricted Google Cloud API key for CreateAssessment (practical on Vercel):
# GOOGLE_CLOUD_API_KEY=
# D) Service-account JSON string (parse server-side only; preserve \n in private_key):
# GOOGLE_SERVICE_ACCOUNT_KEY=
# Or path-based credentials:
# GOOGLE_APPLICATION_CREDENTIALS=

# Local development only. Never enable in production.
# RECAPTCHA_BYPASS_DEV=true
